{
  "name": "ubi",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "dev",
  "containerUser": "dev",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "containerEnv": {
    "UBI_DEVCONTAINER": "1"
  },
  "remoteEnv": {
    "UBI_FORWARDED_GITHUB_TOKEN": "${localEnv:UBI_FORWARDED_GITHUB_TOKEN}",
    "UBI_FORWARDED_GITLAB_TOKEN": "${localEnv:UBI_FORWARDED_GITLAB_TOKEN}",
    "UBI_FORWARDED_CODEBERG_TOKEN": "${localEnv:UBI_FORWARDED_CODEBERG_TOKEN}"
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}
